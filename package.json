{
  "name": "geonomics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "extract:excel": "node scripts/extractFromExcel.js",
    "fetch:stocks": "node scripts/fetchStockData.js",
    "fetch:fuel": "node scripts/fetchFuelPrices.js",
    "prebuild": "node scripts/extractFromExcel.js && node scripts/fetchStockData.js && node scripts/fetchFuelPrices.js",
    "build": "tsc -b && vite build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d docs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "chart.js": "^4.5.1",
    "country-flag-icons": "^1.6.20",
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  }
}
